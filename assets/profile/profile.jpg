<!-- Placeholder profile image for Azad Kumar portfolio -->
<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="400" fill="#0a0b0d" rx="20"/>

  <!-- Profile silhouette -->
  <circle cx="200" cy="150" r="80" fill="#00FF9D" opacity="0.2"/>
  <path d="M200 230 Q 180 280 200 330 Q 220 280 200 230" fill="#00FF9D" opacity="0.3"/>

  <!-- Data elements -->
  <g transform="translate(100, 100) scale(0.4)">
    <!-- Data point 1 -->
    <circle cx="50" cy="50" r="8" fill="#00FF9D" opacity="0.6"/>
    <text x="50" y="50" text-anchor="middle" dy=".3em" fill="#0a0b0d" font-family="monospace" font-size="12" font-weight="bold">50K</text>

    <!-- Data point 2 -->
    <circle cx="150" cy="30" r="6" fill="#00FF9D" opacity="0.4"/>
    <text x="150" y="30" text-anchor="middle" dy=".3em" fill="#0a0b0d" font-family="monospace" font-size="10">ML</text>

    <!-- Data point 3 -->
    <circle cx="250" cy="60" r="10" fill="#00FF9D" opacity="0.5"/>
    <text x="250" y="60" text-anchor="middle" dy=".3em" fill="#0a0b0d" font-family="monospace" font-size="11">100%</text>
  </g>

  <!-- Border frame -->
  <rect x="10" y="10" width="380" height="380" fill="none" stroke="#00FF9D" stroke-width="2" rx="20" opacity="0.3"/>

  <!-- Label -->
  <text x="200" y="360" text-anchor="middle" fill="#00FF9D" font-family="monospace" font-size="14" font-weight="bold">Azad Kumar</text>
</svg>