# === DEPLOYABLE FILES (KEEP) ===
# These are NOT ignored — they make up your portfolio site:
# index.html, style.css, script.js, .nojekyll
# assets/, projects/, fonts/, README.md

# === IGNORED (local/dev/tooling only) ===

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/

# Claude / AI agent tooling
.claude/
.claude-flow/
.agents/
.swarm/
.claude/settings.local.json

# MCP / tools config
.mcp.json
.mcp.*

# Local dev artifacts & scripts
*.mjs
CLAUDE.md
prompts.txt
skills-lock.json

# Internal personal/portfolio docs (not part of live site)
personal_info/
portfolio_info/

# Misc temp/random files
.random.txt
*.tmp
*.temp

# Build / cache artifacts (in case added later)
node_modules/
dist/
build/
coverage/
.nyc_output/
.cache/
*.log
npm-debug.log*
